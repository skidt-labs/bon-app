# Das Datenbankpasswort steht in secrets/db-password (0600) und wird den Containern
# als DATEI eingehaengt, nicht als Umgebungsvariable: `docker inspect` zeigt die
# Umgebung jedem, der an den Docker-Socket kommt. compose.yaml setzt dafuer
# DATABASE_URL_TEMPLATE und DB_PASSWORD_FILE; zusammengebaut wird zur Laufzeit
# (src/lib/server/db/url.ts).
#
# DB_PASSWORD wird weiterhin gebraucht — aber nur noch fuer Werkzeuge, die VOM HOST
# auf die Datenbank gehen (drizzle-kit, die Waechter hinter RUN_DB_TESTS). Diese setzen
# sich daraus ein DATABASE_URL zusammen, das Vorrang hat.
DB_PASSWORD=
# Nur fuer Werkzeuge vom Host; die Container brauchen es NICHT.
DATABASE_URL=postgres://bon:CHANGEME@127.0.0.1:55432/bon
ORIGIN=https://bon.example.org
OIDC_ISSUER=https://auth.example.org/application/o/bon-app/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SESSION_SECRET=
RECEIPT_DIR=./data/receipts
# Zwei Auslesewege, und der Unterschied ist kein technischer Geschmack:
#   ocr-text      PaddleOCR liest das Bild HIER, nur die ausgelesenen Zeichen gehen
#                 an das Modell. Das Foto verlaesst die eigene Maschine nicht.
#   openai-compat Das Bon-FOTO selbst geht als base64 an das Modell.
# Eingebaut ist openai-compat — deshalb steht hier ausdruecklich ocr-text, und
# deshalb verweigert der Worker den Bildweg ohne die Bestaetigung weiter unten.
EXTRACTION_PROVIDER=ocr-text
# Adresse eines OpenAI-kompatiblen Modells. BEWUSST LEER: hier gehoeren Kassenbons
# durch. Ein vorgegebener Cloud-Anbieter waere genau der stille Rueckfall, den dieses
# Programm vermeiden will. Ueblich ist etwas Lokales, z. B. http://127.0.0.1:1234/v1
# (LM Studio), http://127.0.0.1:11434/v1 (Ollama) oder ein eigener MLX-/llama.cpp-Dienst.
EXTRACTION_BASE_URL=
EXTRACTION_MODEL=
EXTRACTION_API_KEY=
# Nur noetig, wenn EXTRACTION_PROVIDER=openai-compat laufen soll: dann geht das FOTO
# des Bons hinaus. Der Worker startet in dem Fall nur mit genau dem Wert "ja" —
# "true" oder "1" reichen absichtlich nicht. Wer das Bild herausgibt, soll es
# bewusst tun und nicht aus Gewohnheit.
EXTRACTION_BILDWEG_BESTAETIGT=
# Zeitlimit je Auslesung in Millisekunden. Leer lassen = 30000 (passt fuer Cloud-Anbieter).
# Fuer den Mac: 300000. Hergeleitet aus dem Auslegungsfall in queue/fristen.ts — ein Bon
# mit 60 Positionen braucht rund 245 s. Mehr als 540000 wird abgelehnt, weil das Zeitlimit
# zuverlaessig VOR pg-bosses Auftragsverfall (600 s) greifen muss; sonst laeuft ein zweiter
# Versuch an, waehrend der erste noch unterwegs ist.
# Ein unbrauchbarer Wert laesst den Dienst absichtlich mit einer klaren Meldung scheitern
# statt still auf 30000 zurueckzufallen; sonst faende niemand den Tippfehler.
EXTRACTION_TIMEOUT_MS=
# Preis je MILLION Token in Mikro-Euro (1 EUR = 1.000.000). Bewusst ohne Vorgabewert:
# modell- UND wechselkursabhaengig. Fehlen sie, bleibt extraction_runs.cost_micro_euros
# null — eine erfundene 0 wuerde behaupten, der Aufruf sei kostenlos gewesen.
EXTRACTION_PRICE_IN_MICRO=
EXTRACTION_PRICE_OUT_MICRO=
MATRIX_HOMESERVER=
MATRIX_ROOM=
MATRIX_TOKEN=
# Zugangsdaten des eigenen Bot-Kontos (bon-matrix) — anderes Konto/Token als
# MATRIX_TOKEN oben, das nur für Alarme in "Server Alarme" postet.
MATRIX_BOT_TOKEN=
# Die Matrix-Kennung dieses Bot-Kontos, etwa @bon:example.org. Die Einstellungsseite
# zeigt sie an, damit man weiss, wohin die Fotos gehen. Welche Absender der Bot
# annimmt, liest er dagegen aus seinem eigenen Konto, nicht von hier.
MATRIX_BOT_USER=
# Verzeichnis für den dauerhaften E2E-Krypto-Speicher des Bots (Volume
# bon_matrix_crypto). Ohne stabilen Pfad verliert der Bot bei jedem Deploy seine
# Schlüssel und kann nichts mehr entschlüsseln.
MATRIX_CRYPTO_DIR=/app/data/matrix-crypto

# --- OCR-Engine ---------------------------------------------------------------
# Welche Engine den Bontext liest: "tesseract" (Voreinstellung, leer lassen genuegt)
# oder "paddleocr". Ein unbekannter Wert laesst den Dienst beim Start mit einer klaren
# Meldung scheitern — bewusst KEIN stiller Rueckfall auf tesseract, sonst maesse ein
# Vergleich zweimal dieselbe Engine.
#
# paddleocr braucht den Container bon-paddleocr (compose.yaml). Er liest langsamer
# (3,7-15,6 s je Bon gegen rund 1 s) und belegt rund 1,1 GB, liest dafuer Bons richtig,
# bei denen Artikelname und Preis in getrennten Zeilen stehen.
OCR_PROVIDER=
# Adresse des PaddleOCR-Dienstes. Leer = http://bon-paddleocr:8000, also der
# Nachbarcontainer. Muss mit http:// oder https:// beginnen; alles andere scheitert
# beim Start, damit eine Messung nicht auf einen Dienst zeigt, den niemand gemeint hat.
OCR_PADDLE_URL=
# Koordinaten und Confidence einsammeln ("true"/"false", leer = false). Kostet bei
# tesseract einen zweiten Prozesslauf; heute liest sie niemand. Nur "true"/"false" —
# "1" oder "yes" scheitern absichtlich laut statt still zu einem Nein zu werden.
OCR_INCLUDE_BOXES=

# Anzeigename des Identitaetsanbieters auf der Anmeldeseite (Vorgabe: "Single Sign-On")
OIDC_ANBIETER=Authentik

# Scopes fuer die Anmeldung (Vorgabe: "openid profile email").
# Nur setzen, wenn der Anbieter einen anderen Satz braucht.
#OIDC_SCOPES=openid profile email

# Der oidc_sub des Kontos, das die Instanz betreibt (Betriebsseite /betrieb).
# Nicht gesetzt = es gibt keinen Eigentuemer. Das ist ein gueltiger Zustand.
#SUPERUSER_OIDC_SUB=

# Schluessel fuer die API-Schluessel der KI-Anbieter, die in /betrieb/ki eingetragen
# werden (AES-256-GCM). 32 zufaellige Bytes, base64:  openssl rand -base64 32
# Ohne ihn funktionieren nur Anbieter ohne Schluessel (etwa ein MLX-Server).
# ACHTUNG: Er liegt im selben Backup wie die Datenbank — er schuetzt gegen einen
# abgeflossenen Datenbank-Dump allein, nicht gegen ein abgeflossenes Gesamt-Backup.
# Wechseln: neuen Wert setzen, bon-web und bon-worker neu starten, dann an jedem
# Anbieter den Schluessel neu eingeben.
SECRETS_KEY=

# Eigene Registry und Adresse dieser Instanz (compose.yaml, scripts/release.sh)
BON_REGISTRY=registry.example.org
BON_HOST=bon.example.org
